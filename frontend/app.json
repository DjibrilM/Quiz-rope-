{
  "expo": {
    "name": "QuizRope",
    "slug": "quizrope",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "quizrope",
    "splash": {
      "imageWidth": 300,
      "image": "./assets/splashscreen_logo.png",
      "backgroundColor": "#0D0B14"
    },
    "android": {
      "package": "com.quizrope.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png", // 1024×1024, with transparency OK
        "backgroundColor": "#FFFFFF" // or your brand color
      }
    },
    "ios": {
      "bundleIdentifier": "com.quizrope.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "QuizRope uses your camera to scan QR codes when joining a quiz match and to photograph homework assignments for AI-powered step-by-step explanations."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "QuizRope uses your photo library so you can upload a photo of your homework and receive AI-powered step-by-step explanations to help you learn.",
          "colors": {
            "cropToolbarColor": "#000000"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#000000"
            }
          }
        }
      ],
      "expo-asset",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true,
            "forceStaticLinking": ["RNFBApp", "RNFBAuth", "RNFBFirestore"]
          }
        }
      ],
      "expo-font",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
